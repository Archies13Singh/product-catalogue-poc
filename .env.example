# Copy this file to .env. Every value here is safe to commit; never commit .env itself.

# --- Backend ---
PORT=3000

# Product data source
FAKE_STORE_BASE_URL=https://fakestoreapi.com
# How long the product list is kept in memory before it is fetched again
PRODUCT_CACHE_TTL_SECONDS=60

# The products the business has chosen to feature on the home page, in display order
FEATURED_PRODUCT_IDS=3,5,11,12,18
# How many products appear under "Top rated" on a category page
CATEGORY_TOP_RATED_COUNT=3

# Enquiries
# The inbox that receives enquiries, and the address they are sent from
SALES_INBOX_EMAIL=sales@example.com
MAIL_FROM=no-reply@example.com
# Enquiries allowed per client in each 15 minute window
ENQUIRY_RATE_LIMIT_MAX=5

# Email (SMTP). These defaults point at Mailpit, the local mail catcher.
# To use a real provider, change the host and port and set the user and password.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
