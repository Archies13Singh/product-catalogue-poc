# Copy this file to .env. Every value here is safe to commit; never commit .env itself.

# --- Backend ---
PORT=3000

# Product data source
FAKE_STORE_BASE_URL=https://fakestoreapi.com
# How long the product list is kept in memory before it is fetched again
PRODUCT_CACHE_TTL_SECONDS=60

# The products the business has chosen to feature on the home page, in display order
FEATURED_PRODUCT_IDS=3,5,11,12,18
# How many products appear under "Top rated" on a category page
CATEGORY_TOP_RATED_COUNT=3
